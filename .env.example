# ============================================================================
#  Frontend (Vite) — these ship to the browser, so ONLY public values here.
#  Copy to .env.local for dev; add the same keys in Vercel → Settings → Env Vars.
# ============================================================================

# Supabase → Project Settings → API
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9....

# Synthetic email domain used to turn "phone + password" into Supabase Auth
# credentials. Never receives mail — keep it a non-routable domain.
VITE_AUTH_EMAIL_DOMAIN=salon.local

# Shown in SMS bodies via {{salon}}
VITE_SALON_NAME=آرایشگاه و سالن زیبایی مانا

# The phone number that gets role='owner' on first registration.
VITE_OWNER_PHONE=09120000000


# ============================================================================
#  Edge Function secrets — NEVER put these in .env / .env.local / the repo.
#  Set them with:  supabase secrets set KEY=value
#  (listed here purely as documentation)
# ============================================================================
# SMS_PROVIDER=kavenegar          # kavenegar | melipayamak
# KAVENEGAR_API_KEY=
# KAVENEGAR_SENDER=               # optional; blank = your default line
# MELIPAYAMAK_API_KEY=
# MELIPAYAMAK_SENDER=
# SMS_DRY_RUN=false               # true = log instead of spending credit
# SMS_MAX_BATCH=200
# SMS_ANON_HOURLY_LIMIT=5
# INTERNAL_FUNCTION_SECRET=       # long random string, for server-to-server calls
# ALLOWED_ORIGIN=https://your-app.vercel.app
# SALON_NAME=آرایشگاه و سالن زیبایی مانا
# SALON_TZ_OFFSET_MINUTES=210     # Iran = UTC+03:30
# DEFAULT_REMINDER_HOURS=3
